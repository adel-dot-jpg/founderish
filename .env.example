# Copy to .env and fill in. Next.js, the worker and all scripts read .env.

# Postgres. Local: postgres://postgres:<password>@localhost:5432/founderish
DATABASE_URL=

# Gemini (https://aistudio.google.com/api-keys). Used by lib/llm.ts. Optional GEMINI_MODEL override.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash  (gemini-flash-latest -> 3.8-flash was timing out on 2026-11-01)

# Apollo (Settings > Integrations > API). Sent as the x-api-key header.
APOLLO_API_KEY=

# Agentboxd (https://agentboxd.com/app/api-keys). Keys start with mr_.
AGENTBOXD_API_KEY=
AGENTBOXD_BASE_URL=https://api.agentboxd.com
# Address of the coach inbox. Required when the key is scoped to one inbox; leave empty to create one.
AGENTBOXD_INBOX=
# Any long random string; we pass it when registering the inbound webhook and use it to verify deliveries.
AGENTBOXD_WEBHOOK_SECRET=
# webhook (default) or poll. Poll mode makes the worker check the coach inbox every 30s (no public URL needed).
MAIL_INBOUND_MODE=poll

# GitHub. A fine-grained token with read access to TEST_REPO's contents and metadata.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# owner/name of the repo used in demos and smoke tests
TEST_REPO=

# Public URL of the web service (tracked links + webhooks). Locally, your ngrok/smee URL or http://localhost:3000.
APP_URL=http://localhost:3000

# The demo owner (no auth). Brief emails go here and owner commands are only accepted from here.
OWNER_EMAIL=
# Comma-separated team emails. In DEMO_MODE nothing is sent to any other address.
SEND_ALLOWLIST=
# Anything other than the exact string "false" counts as on.
DEMO_MODE=true

# Optional tuning
# OWNER_NAME=Adel                 # email sign-off
# OWNER_LOCATION=Toronto, Canada  # where Apollo looks for people
# GEMINI_RPM=5                    # requests/min per model; raise when the key has billing
# LLM_USE_RESERVE=1               # demo day only: use the reserved model (gemini-3-flash-preview) first
# FOLLOWUP_AFTER_MINUTES=5760     # follow-up check after a send (4 days); e.g. 3 for a live demo
# TOP_N_DOWN=1 TOP_N_UP=1         # drafts per audience (each costs ~2 LLM calls)
