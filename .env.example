# Copy to .env and fill in. Next.js, the worker and all scripts read .env. `npm run smoke:env` checks it.

# Postgres. Local: postgres://postgres:<password>@localhost:5432/founderish (remote hosts get TLS automatically)
DATABASE_URL=

# Gemini (https://aistudio.google.com/api-keys). Every LLM call goes through lib/llm.ts.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash        # put a model first in the "smart" chain (drafting)
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite  # ...and in the "fast" chain (ranking, checks)
# GEMINI_RPM=5                         # requests/min per model; raise it when the key has billing

# Apollo (Settings > Integrations > API). People search is free; enrichment (emails) costs credits.
APOLLO_API_KEY=

# Agentboxd (https://agentboxd.com/app/api-keys). Keys start with mr_.
AGENTBOXD_API_KEY=
AGENTBOXD_BASE_URL=https://api.agentboxd.com
# Address of the coach inbox. Required when the key is scoped to one inbox; leave empty to create one.
AGENTBOXD_INBOX=
# poll (default here): the worker checks the coach inbox every 30s, no public URL needed.
# webhook: Agentboxd posts to APP_URL/api/webhooks/mail, signed with AGENTBOXD_WEBHOOK_SECRET.
MAIL_INBOUND_MODE=poll
AGENTBOXD_WEBHOOK_SECRET=

# GitHub. A fine-grained token with read access to the contents and metadata of the repos you link.
GITHUB_TOKEN=
# Optional: a push webhook to APP_URL/api/webhooks/github drafts a LinkedIn post about what shipped.
GITHUB_WEBHOOK_SECRET=
# owner/name of a repo for the smoke tests
TEST_REPO=

# Public URL of the web app, used in tracked links, the brief and the tracking snippet.
APP_URL=http://localhost:3000

# The owner (no auth, single user). Briefs go here and owner commands are only accepted from here.
OWNER_EMAIL=
# Comma-separated. In DEMO_MODE nothing is sent to any other address, and found contacts get these addresses.
SEND_ALLOWLIST=
# On unless set to exactly "false". Turning it off sends real email to real people.
DEMO_MODE=true

# Optional tuning
# OWNER_NAME=Alex                   # email sign-off and how receipts refer to you
# OWNER_LOCATION=Toronto, Canada    # where Apollo looks for people
# FOLLOWUP_AFTER_MINUTES=5760       # follow-up check after a send (default 4 days)
# TOP_N_DOWN=1 TOP_N_UP=1           # drafts per audience search (each costs ~2 LLM calls)
